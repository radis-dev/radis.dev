---
import { Image } from 'astro:assets'

import Layout from '@/layouts/Layout.astro'

import BookIcon from '@/components/icons/Book.svg'
import BriefcaseIcon from '@/components/icons/Briefcase.svg'
import ChalkboardIcon from '@/components/icons/Chalkboard.svg'
import CodeIcon from '@/components/icons/Code.svg'

import Project from '@/components/about/project/Project.astro'
import Experience from '@/components/about/experience/Experience.astro'
import Training from '@/components/about/training/Training.astro'
import Skill from '@/components/about/skill/Skill.astro'
import SocialLinks from '@/components/about/SocialLinks.astro'

const title = 'Sobre mi - RadisDev'
const description =
	'¡Hola! Soy Raúl, Desarrollador Backend Junior. Descubre contenido sobre desarrollo web, tecnología y más para alimentar tu curiosidad por la informática.'
---

<Layout
	title={title}
	description={description}
	openGraph={{
		title: title,
		description: description,
		image: { url: '/og.png' },
	}}
>
	<h1 class="text-text-title_light dark:text-text-title_dark mb-6 text-4xl font-bold sm:mb-10 sm:text-5xl">
		¡Hola!
		<span class="animation-emoji-hand -ml-1" aria-hidden="true">👋</span>
	</h1>
	<section class="flex flex-col items-center justify-center gap-8 md:flex-row">
		<div class="order-2 space-y-6 md:order-1 [&>p]:text-justify [&>p>strong]:font-normal [&>p>strong]:text-black dark:[&>p>strong]:text-white">
			<p>
				Soy <strong>Raúl</strong>, <strong>Desarrollador Backend Junior</strong> y mi lema es simple:
				<strong>"Más que código, transformo ideas en soluciones eficientes."</strong>
			</p>
			<p>
				Lo que empezó como una curiosidad se ha convertido en mi profesión. Hoy tengo un enfoque claro en
				<strong>tres áreas</strong> donde disfruto <strong>creando valor real a través de la tecnología:</strong>
			</p>
			<ul class="grid grid-cols-3 gap-6">
				<li>
					<h3 class="flex items-center justify-center gap-2 font-semibold text-white">
						<span class="text-xl" aria-hidden="true">🧩</span> Desarrollo Backend
					</h3>
				</li>

				<li>
					<h3 class="flex items-center justify-center gap-2 font-semibold text-white">
						<span class="text-xl" aria-hidden="true">📊</span> Análisis de Datos
					</h3>
				</li>
				<li>
					<h3 class="flex items-center justify-center gap-2 font-semibold text-white">
						<span class="text-xl" aria-hidden="true">☁️</span> Cloud & DevOps
					</h3>
				</li>
			</ul>
			<p>
				Y siempre estoy abierto a conversar sobre
				<strong>nuevos desafíos tecnológicos, proyectos innovadores o ideas que transformar el código en valor real</strong>.
			</p>
			<SocialLinks />
		</div>
		<Image
			src="/images/about/me.webp"
			width={958}
			height={1430}
			alt="Fotografía de un joven de pie al aire libre, rodeado de vegetación y árboles, que mira a la cámara con una ligera sonrisa. Lleva puesta una camiseta polo color lila y el fondo muestra un entorno natural y soleado."
			class="border-border_light dark:border-border_dark order-1 aspect-square h-full w-64 rounded-2xl border-2 object-cover md:order-2 lg:w-64"
		/>
	</section>
	<section id="experiencia">
		<h2 class="text-text-title_light dark:text-text-title_dark mt-10 mb-6 flex items-center gap-x-3 text-2xl font-bold sm:text-3xl">
			<BriefcaseIcon class="fill-fill_light dark:fill-fill_dark size-6" />
			Experiencia laboral
		</h2>
		<Experience />
	</section>
	<section id="formacion">
		<h2 class="text-text-title_light dark:text-text-title_dark mt-10 mb-6 flex items-center gap-x-3 text-2xl font-bold sm:text-3xl">
			<BookIcon class="fill-fill_light dark:fill-fill_dark size-6" />
			Formacion
		</h2>
		<Training />
	</section>
	<section id="habilidades">
		<h2 class="text-text-title_light dark:text-text-title_dark mt-10 mb-6 flex items-center gap-x-3 text-2xl font-bold sm:text-3xl">
			<CodeIcon class="fill-fill_light dark:fill-fill_dark size-6" />
			Habilidades tecnicas
		</h2>
		<Skill />
	</section>
	<section id="proyectos">
		<h2 class="text-text-title_light dark:text-text-title_dark mt-10 mb-6 flex items-center gap-x-3 text-2xl font-bold sm:text-3xl">
			<ChalkboardIcon class="fill-fill_light dark:fill-fill_dark size-6" />
			Proyectos
		</h2>
		<Project />
	</section>
</Layout>
